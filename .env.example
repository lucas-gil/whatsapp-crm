# Example .env for deployments
# Set a Redis password and avoid exposing Redis port on host
REDIS_PASSWORD=changeme123
# Optionally set REDIS_URL explicitly (overrides REDIS_PASSWORD fallback)
# REDIS_URL=redis://:changeme123@redis:6379

# Database (overrides docker-compose defaults)
DATABASE_URL=postgresql://whatsapp_user:whatsapp_password@postgres:5432/whatsapp_crm

# App
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
